#!/usr/bin/env bash

set -euo pipefail

base=$(basename "$0")

input=""
fg_color=""
bg_color=""
newline=1
styles=""

usage() {
  cat <<EOF
Usage: $base [options] [text]

Available options:
  -h, --help             Print this help and exit
  -t, --text TEXT        Text to print
  -f, --fg COLOR         Foreground color, 0-255
  -b, --bg COLOR         Background color, 0-255
  -s, --style STYLE      Style to apply; repeatable
  -n, --no-newline       Do not print the trailing newline

Available styles:
  bold
  dim
  italic
  underline
  curly-underline
  blink
  reverse
  strikethrough

Examples:
EOF
  printf '  %s %s\n' "$base" "'Hello, World!'"
  printf '    Hello, World!\n\n'
  printf '  %s %s\n' "$base" "'Hello, World!' -f 42"
  printf '    \033[38;5;42mHello, World!\033[0m\n\n'
  printf '  %s %s\n' "$base" "'Warning' --fg=196 --style=bold"
  printf '    \033[38;5;196;1mWarning\033[0m\n\n'
  printf '  %s %s\n' "$base" "'Selected' -f 15 -b 24 -s bold -s underline"
  printf '    \033[38;5;15;48;5;24;1;4mSelected\033[0m\n\n'
  printf '  %s\n' "printf 'No newline' | $base -f 70 --no-newline"
  printf '    \033[38;5;70mNo newline\033[0m\n\n'
  printf '  %s %s\n' "$base" "-- -f 1"
  printf '    -f 1\n\n'
}

debug() {
  local debug=${DEBUG:-}
  if [ "$debug" = "*" ] || [[ "$debug" =~ (^|,)"$base"($|,) ]]; then
    echo "[debug.$base] $1"
  fi
}

read_stdin() { [ -t 0 ] || cat; }

die() {
  echo "$base: $1" >&2
  exit 1
}

is_color_code() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( $1 >= 0 && $1 <= 255 ))
}

style_sgr() {
  case "$1" in
  bold) printf '1' ;;
  dim) printf '2' ;;
  italic) printf '3' ;;
  underline) printf '4' ;;
  curly-underline) printf '4:3' ;;
  blink) printf '5' ;;
  reverse) printf '7' ;;
  strikethrough) printf '9' ;;
  *) return 1 ;;
  esac
}

join_sgr() {
  local IFS=";"
  printf '%s' "$*"
}

need_value() {
  local option="$1"
  local value="${2:-}"

  [[ -n "$value" ]] || die "$option requires an argument"
  printf '%s' "$value"
}

parse_args() {
  local -a text_parts=()
  local option=""
  local value=""

  while (($# > 0)); do
    case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -n|--no-newline)
      newline=0
      shift
      ;;
    -t|--text)
      input="$(need_value "$1" "${2:-}")"
      shift 2
      ;;
    --text=*)
      input="${1#--text=}"
      shift
      ;;
    -f|--fg)
      fg_color="$(need_value "$1" "${2:-}")"
      shift 2
      ;;
    --fg=*)
      fg_color="${1#--fg=}"
      shift
      ;;
    -b|--bg)
      bg_color="$(need_value "$1" "${2:-}")"
      shift 2
      ;;
    --bg=*)
      bg_color="${1#--bg=}"
      shift
      ;;
    -s|--style)
      value="$(need_value "$1" "${2:-}")"
      styles+="${value}"$'\n'
      shift 2
      ;;
    --style=*)
      value="${1#--style=}"
      [[ -n "$value" ]] || die "--style requires an argument"
      styles+="${value}"$'\n'
      shift
      ;;
    --)
      shift
      text_parts+=("$@")
      break
      ;;
    --*)
      die "invalid option: $1"
      ;;
    -*)
      option="$1"
      die "invalid option: $option"
      ;;
    *)
      text_parts+=("$1")
      shift
      ;;
    esac
  done

  if [ -z "$input" ] && ((${#text_parts[@]} > 0)); then
    input="${text_parts[*]}"
  fi
}

main() {
  debug "Options
    input    $input
    fg_color $fg_color
    bg_color $bg_color
    styles   $styles
  "

  [ -n "$input" ] || input="$(read_stdin)"
  [ -n "$input" ] || die "missing text"

  local -a sgr=()
  local style_code=""

  if [ -n "$fg_color" ]; then
    is_color_code "$fg_color" || die "foreground color must be between 0 and 255"
    sgr+=("38;5;$fg_color")
  fi

  if [ -n "$bg_color" ]; then
    is_color_code "$bg_color" || die "background color must be between 0 and 255"
    sgr+=("48;5;$bg_color")
  fi

  if [ -n "$styles" ]; then
    while IFS= read -r style; do
      [ -n "$style" ] || continue
      style_code="$(style_sgr "$style")" || die "unknown style: $style"
      sgr+=("$style_code")
    done <<< "$styles"
  fi

  if ((${#sgr[@]} > 0)); then
    printf '\033[%sm%s\033[0m' "$(join_sgr "${sgr[@]}")" "$input"
  else
    printf '%s' "$input"
  fi

  if (( newline )); then
    printf '\n'
  fi
}

parse_args "$@"
main "$@"
