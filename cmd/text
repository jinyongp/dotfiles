#!/usr/bin/env bash

set -euo pipefail

base=$(basename "$0")
DOTFILES_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

source "$DOTFILES_ROOT/scripts/lib/ui/help.sh"
source "$DOTFILES_ROOT/scripts/lib/ui/errors.sh"

input=""
fg_color=""
bg_color=""
newline=1
styles=""

usage() {
  ui::help_start "$base" "Apply SGR styling to text."
  ui::help_usage "$base [options] [text]"
  ui::help_options \
    $'-h, --help\t-h, --help\tPrint this help and exit.' \
    $'-t, --text TEXT\t-t, --text TEXT\tText to print.' \
    $'-f, --fg COLOR\t-f, --fg COLOR\tForeground color, 0-255.' \
    $'-b, --bg COLOR\t-b, --bg COLOR\tBackground color, 0-255.' \
    $'-s, --style STYLE\t-s, --style STYLE\tStyle to apply; repeatable.' \
    $'-n, --no-newline\t-n, --no-newline\tDo not print the trailing newline.'
  ui::help_records "Styles:" \
    $'bold\tbold\tBold text.' \
    $'dim\tdim\tDim text.' \
    $'italic\titalic\tItalic text.' \
    $'underline\tunderline\tUnderlined text.' \
    $'curly-underline\tcurly-underline\tCurly underline.' \
    $'blink\tblink\tBlinking text.' \
    $'reverse\treverse\tReverse video.' \
    $'strikethrough\tstrikethrough\tStruck-through text.'
  ui::help_examples \
    "$base 'Hello, World!'" \
    "$base 'Hello, World!' -f 42" \
    "$base 'Warning' --fg=196 --style=bold" \
    "$base 'Selected' -f 15 -b 24 -s bold -s underline" \
    "printf 'No newline' | $base -f 70 --no-newline" \
    "$base -- -f 1"
}

debug() {
  local debug=${DEBUG:-}
  if [ "$debug" = "*" ] || [[ "$debug" =~ (^|,)"$base"($|,) ]]; then
    echo "[debug.$base] $1"
  fi
}

read_stdin() { [ -t 0 ] || cat; }

die() {
  local message="$1"
  local field="${2:-}"

  if [[ -n "$field" ]]; then
    ui::validation_error "$message" "$field" $'usage\t'"$base [options] [text]"
  else
    ui::validation_error "$message" $'usage\t'"$base [options] [text]"
  fi
  exit 1
}

is_color_code() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( $1 >= 0 && $1 <= 255 ))
}

style_sgr() {
  case "$1" in
  bold) printf '1' ;;
  dim) printf '2' ;;
  italic) printf '3' ;;
  underline) printf '4' ;;
  curly-underline) printf '4:3' ;;
  blink) printf '5' ;;
  reverse) printf '7' ;;
  strikethrough) printf '9' ;;
  *) return 1 ;;
  esac
}

join_sgr() {
  local IFS=";"
  printf '%s' "$*"
}

need_value() {
  local option="$1"
  local value="${2:-}"

  [[ -n "$value" ]] || die "$option requires an argument" $'option\t'"$option"
  printf '%s' "$value"
}

parse_args() {
  local -a text_parts=()
  local option=""
  local value=""

  while (($# > 0)); do
    case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -n|--no-newline)
      newline=0
      shift
      ;;
    -t|--text)
      input="$(need_value "$1" "${2:-}")"
      shift 2
      ;;
    --text=*)
      input="${1#--text=}"
      shift
      ;;
    -f|--fg)
      fg_color="$(need_value "$1" "${2:-}")"
      shift 2
      ;;
    --fg=*)
      fg_color="${1#--fg=}"
      shift
      ;;
    -b|--bg)
      bg_color="$(need_value "$1" "${2:-}")"
      shift 2
      ;;
    --bg=*)
      bg_color="${1#--bg=}"
      shift
      ;;
    -s|--style)
      value="$(need_value "$1" "${2:-}")"
      styles+="${value}"$'\n'
      shift 2
      ;;
    --style=*)
      value="${1#--style=}"
      [[ -n "$value" ]] || die "--style requires an argument" $'option\t--style'
      styles+="${value}"$'\n'
      shift
      ;;
    --)
      shift
      text_parts+=("$@")
      break
      ;;
    --*)
      die "invalid option" $'option\t'"$1"
      ;;
    -*)
      option="$1"
      die "invalid option" $'option\t'"$option"
      ;;
    *)
      text_parts+=("$1")
      shift
      ;;
    esac
  done

  if [ -z "$input" ] && ((${#text_parts[@]} > 0)); then
    input="${text_parts[*]}"
  fi
}

main() {
  debug "Options
    input    $input
    fg_color $fg_color
    bg_color $bg_color
    styles   $styles
  "

  [ -n "$input" ] || input="$(read_stdin)"
  [ -n "$input" ] || die "missing text" $'input\t'

  local -a sgr=()
  local style_code=""

  if [ -n "$fg_color" ]; then
    is_color_code "$fg_color" || die "foreground color must be between 0 and 255" $'fg\t'"$fg_color"
    sgr+=("38;5;$fg_color")
  fi

  if [ -n "$bg_color" ]; then
    is_color_code "$bg_color" || die "background color must be between 0 and 255" $'bg\t'"$bg_color"
    sgr+=("48;5;$bg_color")
  fi

  if [ -n "$styles" ]; then
    while IFS= read -r style; do
      [ -n "$style" ] || continue
      style_code="$(style_sgr "$style")" || die "unknown style" $'style\t'"$style"
      sgr+=("$style_code")
    done <<< "$styles"
  fi

  if ((${#sgr[@]} > 0)); then
    printf '\033[%sm%s\033[0m' "$(join_sgr "${sgr[@]}")" "$input"
  else
    printf '%s' "$input"
  fi

  if (( newline )); then
    printf '\n'
  fi
}

parse_args "$@"
main "$@"
