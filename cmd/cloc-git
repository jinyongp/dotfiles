#!/usr/bin/env bash

set -euo pipefail

cmd="$(basename "$0")"
DOTFILES_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
tmp_dir=""
clone_log=""

source "$DOTFILES_ROOT/scripts/lib/ui/help.sh"
source "$DOTFILES_ROOT/scripts/lib/ui/errors.sh"

cleanup() {
  [[ -n "$tmp_dir" && -d "$tmp_dir" ]] && rm -rf "$tmp_dir"
  [[ -n "$clone_log" && -f "$clone_log" ]] && rm -f "$clone_log"
  return 0
}

trap cleanup EXIT

usage() {
  ui::help_start "$cmd" "Clone a repository into a temporary directory and run cloc against it."
  ui::help_usage "$cmd <git-url>"
  ui::help_examples \
    "$cmd https://github.com/jinyongp/untouchable" \
    "$cmd git@github.com:owner/private-repo.git"
}

die() {
  local message="$1"
  local field="${2:-}"

  if [[ -n "$field" ]]; then
    ui::validation_error "$message" "$field" $'usage\t'"$cmd <git-url>"
  else
    ui::validation_error "$message" $'usage\t'"$cmd <git-url>"
  fi
  exit 1
}

info() {
  if ui::is_json; then
    return 0
  fi

  echo "$cmd: $1" >&2
}

warn() {
  local message="$1"
  local field="${2:-}"

  if ui::is_json; then
    if [[ -n "$field" ]]; then
      local label="${field%%$'\t'*}"
      local value="${field#*$'\t'}"
      ui::json_event warning cli "{\"message\":\"$(ui::json_escape "$message")\",\"fields\":{\"$(ui::json_escape "$label")\":\"$(ui::json_escape "$value")\"}}" >&2
    else
      ui::json_event warning cli "{\"message\":\"$(ui::json_escape "$message")\",\"fields\":{}}" >&2
    fi
    return 0
  fi

  ui::warn "$message"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command" $'command\t'"$1"
}

github_slug() {
  local url="$1"
  local slug=""

  case "$url" in
    https://github.com/*|http://github.com/*)
      slug="${url#*://github.com/}"
      ;;
    git@github.com:*)
      slug="${url#git@github.com:}"
      ;;
    ssh://git@github.com/*)
      slug="${url#ssh://git@github.com/}"
      ;;
    *)
      return 1
      ;;
  esac

  slug="${slug%%\?*}"
  slug="${slug%%#*}"
  slug="${slug%/}"
  slug="${slug%.git}"

  [[ "$slug" == */* ]] || return 1
  printf '%s' "$slug"
}

github_ssh_url() {
  local slug="$1"
  printf 'git@github.com:%s.git' "$slug"
}

clone_repo() {
  local repo_url="$1"
  local slug=""
  local clone_url="$repo_url"
  local git_ssh_command="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}"

  if slug="$(github_slug "$repo_url")"; then
    if command -v gh >/dev/null 2>&1 && GH_PROMPT_DISABLED=1 gh auth status -h github.com >/dev/null 2>&1; then
      info "cloning github.com/$slug with gh..."
      GH_PROMPT_DISABLED=1 gh repo clone "$slug" "$tmp_dir" -- --depth 1 --quiet >"$clone_log" 2>&1
      return
    fi

    clone_url="$(github_ssh_url "$slug")"
    info "cloning github.com/$slug with ssh..."
  else
    info "cloning repository..."
  fi

  GIT_SSH_COMMAND="$git_ssh_command" GIT_TERMINAL_PROMPT=0 git clone --quiet --depth 1 "$clone_url" "$tmp_dir" >"$clone_log" 2>&1
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if [[ $# -ne 1 ]]; then
  die "missing git URL" $'argument\tgit-url'
fi

require_command git
require_command cloc

tmp_parent="${TMPDIR:-/tmp}"
tmp_parent="${tmp_parent%/}"
tmp_dir="$(mktemp -d "$tmp_parent/cloc-git.XXXXXX")"
clone_log="$(mktemp "$tmp_parent/cloc-git.XXXXXX.log")"

if ! clone_repo "$1"; then
  if ! ui::is_json; then
    cat "$clone_log" >&2
  fi
  if github_slug "$1" >/dev/null 2>&1; then
    warn "GitHub private repos require either valid gh auth or SSH access." $'repository\t'"$1"
  elif ui::is_json; then
    ui::validation_error "failed to clone repository" $'repository\t'"$1"
  fi
  exit 1
fi

info "counting lines..."
cloc "$tmp_dir"
