#!/usr/bin/env bash

set -euo pipefail

base="$(basename "$0")"
DOTFILES_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

source "$DOTFILES_ROOT/scripts/lib/ui/help.sh"
source "$DOTFILES_ROOT/scripts/lib/ui/errors.sh"

usage() {
  ui::help_start "$base" "Print the 256-color ANSI palette."
  ui::help_usage "$base [options] [label]"
  ui::help_options \
    $'-h, --help\t-h, --help\tPrint this help and exit.'
  ui::help_examples \
    "$base" \
    "$base 'OK'"
}

label_text=""

while (($# > 0)); do
  case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  --)
    shift
    break
    ;;
  -*)
    ui::validation_error "unknown option" \
      $'option\t'"$1" \
      $'usage\t'"$base [options] [label]"
    exit 1
    ;;
  *)
    break
    ;;
  esac
done

label_text="$*"

for ((i = 0; i <= 255; i++)); do
  color="$(printf '%03d' "$i")"
  label="${label_text:-$color}"
  printf '\x1b[48;5;%sm %s \x1b[0m ' "$color" "$label"
  printf '\x1b[38;5;%sm%s\x1b[0m ' "$color" "$label"

  [[ "$i" -lt 16 && $(((i + 1) % 8)) -eq 0 ]] && echo
  [[ "$i" -ge 16 && $(((i - 15) % 6)) -eq 0 ]] && echo
  [[ "$i" -lt 16 && $(((i + 1) % 16)) -eq 0 ]] && echo
  [[ "$i" -ge 16 && $(((i - 15) % 36)) -eq 0 ]] && echo
done

echo
