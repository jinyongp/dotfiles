{
  "[shellscript]": {
    "editor.defaultFormatter": "bmalehorn.shell-syntax"
  },
  "cSpell.numSuggestions": 0,
  "cSpell.customDictionaries": {
    "words": {
      "name": "Workspace",
      "path": "${workspaceRoot}/.vscode/dictionary.txt",
      "addWords": true,
      "scope": "workspace"
    },
    "custom": true,
    "internal-terms": false
  },
}