#compdef dotfiles dfx

local -a entries
local command_name target

command_name="${words[2]:-}"
target="${words[3]:-}"

case "$CURRENT" in
  2)
    entries=("${(@f)$(dotfiles complete commands 2>/dev/null)}")
    _describe -V -t commands 'dotfiles command' entries
    ;;
  3)
    case "$command_name" in
      install)
        entries=("${(@f)$(dotfiles complete targets 2>/dev/null)}")
        _describe -V -t install-targets 'install target' entries
        ;;
      uninstall)
        entries=(
          '-y:run uninstall without interactive confirmation'
          '--yes:run uninstall without interactive confirmation'
        )
        _describe -V -t uninstall-options 'uninstall option' entries
        ;;
      agents)
        entries=(
          'list:list internal and external agent skills'
          'sync:update sources and reconcile agent skill links'
        )
        _describe -V -t agents-commands 'agents command' entries
        ;;
      themes)
        entries=("${(@f)$(dotfiles complete theme-commands 2>/dev/null)}")
        _describe -V -t themes-commands 'themes command' entries
        ;;
    esac
    ;;
  *)
    case "$command_name" in
      install)
        entries=("${(@f)$(dotfiles complete items "$target" 2>/dev/null)}")
        if (( ${#entries[@]} > 0 )); then
          _describe -V -t install-items 'install item' entries
        fi
        ;;
      agents)
        case "$target" in
          sync)
            entries=("${(@f)$(dotfiles complete agent-skills 2>/dev/null)}")
            _describe -V -t agent-skills 'agent skill' entries
            ;;
        esac
        ;;
      themes)
        case "$target" in
          use)
            entries=("${(@f)$(dotfiles complete items themes 2>/dev/null)}")
            _describe -V -t shell-themes 'shell theme' entries
            ;;
        esac
        ;;
    esac
    ;;
esac
